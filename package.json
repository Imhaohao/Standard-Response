{
  "name": "calhacks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p tests",
    "dev:voice": "tsx watch --env-file=.env.local voice/server.ts",
    "voice": "tsx voice/server.ts",
    "predeploy:voice": "tsx --env-file=.env.local scripts/voice/deploy-guard.ts",
    "deploy:voice": "fly deploy . --config voice/fly.toml --dockerfile voice/Dockerfile",
    "test:mesh": "tsx --test lib/mesh/*.test.ts lib/crowd/*.test.ts",
    "test:prepare": "tsx --test lib/prepare/*.test.ts",
    "test:hazard": "tsx --test scripts/hazard/*.test.ts",
    "test:voice": "tsx --test voice/*.test.ts voice/agent/*.test.ts voice/phone/*.test.ts voice/knowledge/*.test.ts",
    "test:workflow": "vitest run tests/workflow --environment edge-runtime",
    "stress:convex": "tsx scripts/stress/run.ts",
    "exam:voice": "tsx --env-file=.env.local voice/exam/run.ts",
    "forecast:traffic": "tsx --env-file=.env.local scripts/mesh/traffic-forecast.ts",
    "knowledge:generate": "VOICE_MODEL=claude-haiku-5-5 VOICE_KNOWLEDGE=off VOICE_HEDGED_REQUESTS=1 tsx --env-file=.env.local voice/knowledge/generate.ts",
    "moss:index": "tsx --env-file=.env.local scripts/moss/build-answer-index.ts",
    "moss:check": "tsx --env-file=.env.local scripts/moss/answer-check.ts",
    "apify:drill": "tsx --env-file=.env.local scripts/apify/drill.ts",
    "knowledge:index": "tsx --env-file=.env.local voice/knowledge/upload.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth0/nextjs-auth0": "^4.33.0",
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/workflow": "^0.4.10",
    "@inferedge/moss": "1.0.0-beta.8",
    "@phosphor-icons/react": "^2.1.10",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.129",
    "jsqr": "^1.4.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "twilio": "^6.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@convex-dev/batch-worker": "0.3.3",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "convex-test": "^0.0.65",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
