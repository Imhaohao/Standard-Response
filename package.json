{
  "name": "calhacks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "dev:voice": "tsx watch --env-file=.env.local voice/server.ts",
    "voice": "tsx voice/server.ts",
    "deploy:voice": "fly deploy . --config voice/fly.toml --dockerfile voice/Dockerfile",
    "test:mesh": "tsx --test lib/mesh/*.test.ts lib/crowd/*.test.ts",
    "forecast:traffic": "tsx --env-file=.env.local scripts/mesh/traffic-forecast.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@convex-dev/aggregate": "^0.3.4",
    "@phosphor-icons/react": "^2.1.10",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.129",
    "jsqr": "^1.4.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "twilio": "^6.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
