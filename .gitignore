# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Convex backend state
.convex/

# Modeling Python environment
modeling/.venv/
__pycache__/
modeling/cache/

# Map bake cache and browser screenshots
scripts/map/.cache/
.playwright-mcp/

# Moss index cache and the downloaded 911 call transcripts (voice/knowledge)
/.cache/
data/eaton/fsri-timeline-eaton.csv

# Brand fonts we have no license to publish (Verlag is Hoefler & Co.'s, Nexa Rust a Fontfabric trial).
# They stay on the presenting laptop, and every page falls back to League Spartan without them.
/public/brand-fonts/
# The pitch deck's photos show real people, so they stay on the presenting laptop too.
/public/present/*.jpg
/public/present/*.mp3
